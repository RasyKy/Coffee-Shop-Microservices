# --- STAGE 1: Build ---
# Use official Node.js image to build the app
FROM node:18-slim as build

WORKDIR /app

# Copy package.json and install dependencies
COPY package*.json ./
RUN npm install

# Copy the rest of the app's source code and build the app
COPY . .
# This 'ng build' command creates a 'dist/coffee-shop-ui/browser' folder
RUN ng build --configuration production

# --- STAGE 2: Serve ---
# Use a lightweight Nginx image to serve the static files
FROM nginx:alpine

# Copy the built files from the 'build' stage
# Adjust the source path 'dist/coffee-shop-ui/browser' if your 'ng build' output is different
COPY --from=build /app/dist/coffee-shop-ui/browser /usr/share/nginx/html

# Expose port 80 (Nginx default)
EXPOSE 80